{
  "data": {
    "data_dir": "data/ball_plate",
    "file_glob": "*time_data.npz",
    "percent": 50
  },
  "split": {
    "train": 0.8,
    "valid": 0.1,
    "test": 0.0
  },
  "model": {
    "type": "mesh_graph_net",
    "hidden_dim": 64,
    "node_encoder": {
      "history_len": 5,
      "layer_norm": true
    },
    "edge_encoder": {
      "layer_norm": true
    },
    "gnn_topology": {
      "n_gnn_layers": 10,
      "shared_layers": true,
      "layer_norm": true
    },
    "gnn_surface": {
      "threshold": 22.0,
      "k": 10,
      "layer_norm": true
    },
    "decoder": {
      "out_dim": 6,
      "pred_horizon": 1
    }
  },
  "training": {
    "batch_size": 12,
    "learning_rate": 0.0001,
    "epochs": 100,
    "save_every": 10
  }
}
