{
  "data": {
    "data_dir": "data/ball_plate",
    "file_glob": "*time_data.npz",
    "percent": 100
  },
  "split": {
    "train": 0.8,
    "valid": 0.1,
    "test": 0.0
  },
  "model": {
    "type": "residual_recurrent",
    "hidden_dim": 64,
    "standard_dt": 0.1,
    "node_encoder": {
      "feat_dim": 6,
      "history_len": 5,
      "lstm_layers": 1,
      "use_mass": true,
      "use_pos": false,
      "layer_norm": true
    },
    "edge_encoder": {
      "feat_dim": 7,
      "layer_norm": true
    },
    "gnn_topology": {
      "n_gnn_layers": 10,
      "shared_layers": true,
      "layer_norm": false
    },
    "gnn_surface": {
      "enabled": true,
      "distance_threshold": 22.0,
      "layer_norm": false
    },
    "decoder": {
      "out_dim": 6,
      "pred_horizon": 5
    }
  },
  "training": {
    "batch_size": 12,
    "learning_rate": 0.0001,
    "epochs": 100,
    "save_every": 10
  }
}
